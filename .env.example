# VantaLLM local runtime defaults

# Core model selection
MODEL_CONFIG=configs/vanta_567m.json
QUANT_MODE=bf16
TOKENIZER_PATH=vantallm/tokenizer/cybersec_tokenizer
MODEL_PATH=

# Training
TRAIN_STEPS=10
DATA_MODE=showcase
DATA_PATH=data_pipeline/rag_synthetic_slice_v2_fixed.jsonl
BATCH_SIZE=2
GRAD_ACCUM_STEPS=16
TRAIN_SEQ_LEN=2048
LR_PEAK=3e-6

# Distributed
MASTER_ADDR=127.0.0.1
MASTER_PORT=29500
NCCL_DEBUG=INFO
PYTHONUNBUFFERED=1

# Inference server
HOST=0.0.0.0
PORT=8000
MAX_BATCH_SIZE=8
BATCH_WAIT_MS=20.0
