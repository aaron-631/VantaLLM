{
    "train_micro_batch_size_per_gpu": 4,
    "gradient_accumulation_steps": 32,
    "bf16": {
        "enabled": true
    },
    "zero_optimization": {
        "stage": 2,
        "allgather_partitions": true,
        "allgather_bucket_size": 2e8,
        "overlap_comm": true,
        "reduce_scatter": true,
        "reduce_bucket_size": 2e8,
        "contiguous_gradients": true
    },
    "optimizer": {
        "type": "AdamW",
        "params": {
            "lr": 3e-6,
            "weight_decay": 0.01
        }
    },
    "steps_per_print": 10,
    "wall_clock_breakdown": false
}
